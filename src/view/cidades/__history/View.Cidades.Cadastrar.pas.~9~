unit View.Cidades.Cadastrar;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, View.Herencas.Cadastrar, Data.DB,
  System.ImageList, Vcl.ImgList, Vcl.StdCtrls, Vcl.ExtCtrls, Vcl.Mask, Vcl.DBCtrls, model.cidades.DM;

type
  TViewCidadesCadastrar = class(TViewHerancasCadastrar)
    procedure btnGravarClick(Sender: TObject);
   // procedure DBEdit3Change(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  ViewCidadesCadastrar: TViewCidadesCadastrar;

implementation

{$R *.dfm}



procedure TViewCidadesCadastrar.btnGravarClick(Sender: TObject);
begin
   if(Trim(edtNome.Text).IsEmpty) then
   begin
     edtNome.SetFocus;
     raise Exception.Create('Preencha o campo nome');
   end;

   if(Trim(cBoxUF.Text).IsEmpty) then
   begin
     cBoxUF.SetFocus;
     raise Exception.Create('Preencha o campo UF');
   end;

   if(not Trim(edtCodIBGE.Text).IsEmpty) then
   begin
      if(Length(edtCodIBGE.Text) <> 7) then
      begin
        edtCodIBGE.SetFocus;
        raise Exception.Create('Código do IBGE deve conter 7 caracteres');
      end;
   end;
end;

end.
